          "refId": "A"
        }
      ],
      "title": "Latencia p95 — stable (v1) vs canary (v2)",
      "type": "timeseries"
    },
    {
      "datasource": "Prometheus",
      "description": "Throughput por versao (req/s).",
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" },
